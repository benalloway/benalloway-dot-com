---
import Container from './Container.astro';

const pathname = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'About' },
  { href: '/movies', label: 'Movies' },
  { href: '/articles/favorite-movies', label: 'Favorites' },
  { href: '/articles', label: 'Wiki & Articles' },
];

function isActive(href: string, currentPath: string) {
  if (href === '/') return currentPath === '/';
  if (href === '/articles') {
    return (
      currentPath === '/articles' ||
      (currentPath.startsWith('/articles/') &&
        !currentPath.startsWith('/articles/favorite-movies'))
    );
  }
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="pointer-events-none relative z-50 flex flex-none flex-col">
  <div class="top-0 z-10 pt-6">
    <Container class="w-full">
      <div class="relative flex items-center gap-4">
        <div class="flex flex-1 items-center">
          <a
            href="/"
            aria-label="Ben Alloway — Home"
            class="pointer-events-auto group relative inline-flex items-center gap-3 rounded-full bg-white/90 py-1.5 pr-4 pl-1.5 shadow-lg ring-1 shadow-zinc-800/5 ring-zinc-900/5 backdrop-blur-sm transition hover:ring-zinc-900/10 dark:bg-zinc-800/90 dark:ring-white/10 dark:hover:ring-white/20"
          >
            <span
              class="absolute top-1/2 left-1/2 size-[max(100%,3rem)] -translate-x-1/2 -translate-y-1/2 pointer-fine:hidden"
              aria-hidden="true"></span>
            <img
              src="/images/avatar.jpg"
              alt="Ben Alloway"
              width="36"
              height="36"
              class="size-9 rounded-full bg-zinc-100 object-cover dark:bg-zinc-800"
            />
            <span class="text-sm font-semibold tracking-tight text-zinc-800 group-hover:text-teal-600 dark:text-zinc-100 dark:group-hover:text-teal-400">
              Ben Alloway
            </span>
          </a>
        </div>

        <div class="flex flex-1 justify-end md:justify-center">
          <!-- Mobile Navigation Trigger (MD3 48px minimum touch target) -->
          <div class="pointer-events-auto md:hidden">
            <button
              type="button"
              data-mobile-menu-open
              aria-haspopup="dialog"
              aria-expanded="false"
              aria-controls="mobile-nav-dialog"
              class="group relative flex min-h-12 items-center rounded-full bg-white/90 px-5 py-2.5 text-sm font-medium text-zinc-800 shadow-lg ring-1 shadow-zinc-800/5 ring-zinc-900/5 backdrop-blur-sm transition active:scale-[0.98] dark:bg-zinc-800/90 dark:text-zinc-200 dark:ring-white/10 dark:hover:ring-white/20"
            >
              Menu
              <svg
                viewBox="0 0 8 6"
                aria-hidden="true"
                class="ml-3 h-auto w-2.5 stroke-zinc-500 group-hover:stroke-zinc-700 dark:group-hover:stroke-zinc-400"
              >
                <path
                  d="M1.75 1.75 4 4.25l2.25-2.5"
                  fill="none"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </button>
          </div>

          <!-- Desktop Spotlight Pill Navigation -->
          <nav aria-label="Primary" class="pointer-events-auto hidden md:block">
            <ul class="flex items-center rounded-full bg-white/90 px-3 text-sm font-medium text-zinc-800 shadow-lg ring-1 shadow-zinc-800/5 ring-zinc-900/5 backdrop-blur-sm dark:bg-zinc-800/90 dark:text-zinc-200 dark:ring-white/10">
              {
                navItems.map((item) => {
                  const active = isActive(item.href, pathname);
                  return (
                    <li>
                      <a
                        href={item.href}
                        aria-current={active ? 'page' : undefined}
                        class:list={[
                          'relative block px-3.5 py-2.5 transition',
                          active
                            ? 'text-teal-600 dark:text-teal-400'
                            : 'hover:text-teal-600 dark:hover:text-teal-400',
                        ]}
                      >
                        {item.label}
                        {active && (
                          <span class="absolute inset-x-1 -bottom-px h-px bg-linear-to-r from-teal-500/0 via-teal-500/50 to-teal-500/0 dark:from-teal-400/0 dark:via-teal-400/50 dark:to-teal-400/0" />
                        )}
                      </a>
                    </li>
                  );
                })
              }
            </ul>
          </nav>
        </div>

        <div class="flex justify-end md:flex-1">
          <div class="pointer-events-auto">
            <button
              type="button"
              data-theme-toggle
              aria-label="Toggle color theme"
              class="group relative flex size-12 items-center justify-center rounded-full bg-white/90 shadow-lg ring-1 shadow-zinc-800/5 ring-zinc-900/5 backdrop-blur-sm transition active:scale-[0.98] sm:size-10 dark:bg-zinc-800/90 dark:ring-white/10 dark:hover:ring-white/20"
            >
              <span
                class="absolute top-1/2 left-1/2 size-[max(100%,3rem)] -translate-x-1/2 -translate-y-1/2 pointer-fine:hidden"
                aria-hidden="true"></span>
              <svg
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="size-6 fill-zinc-100 stroke-zinc-500 transition group-hover:fill-zinc-200 group-hover:stroke-zinc-700 sm:size-5 dark:hidden"
              >
                <path d="M8 12.25A4.25 4.25 0 0 1 12.25 8v0a4.25 4.25 0 0 1 4.25 4.25v0a4.25 4.25 0 0 1-4.25 4.25v0A4.25 4.25 0 0 1 8 12.25v0Z"></path>
                <path
                  d="M12.25 3v1.5M21.5 12.25H20M18.791 18.791l-1.06-1.06M18.791 5.709l-1.06 1.06M12.25 20v1.5M4.5 12.25H3M6.77 6.77 5.709 5.709M6.77 17.73l-1.061 1.061"
                  fill="none"></path>
              </svg>
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
                class="hidden size-6 fill-zinc-700 stroke-zinc-400 transition group-hover:stroke-zinc-300 sm:size-5 dark:block"
              >
                <path
                  d="M17.25 16.22a6.937 6.937 0 0 1-9.47-9.47 7.451 7.451 0 1 0 9.47 9.47ZM12.75 7C17 7 17 2.75 17 2.75S17 7 21.25 7C17 7 17 11.25 17 11.25S17 7 12.75 7Z"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </Container>
  </div>
</header>

<!-- Mobile Navigation Sheet (<dialog> island, Spotlight styling + MD3 touch ergonomics) -->
<dialog
  id="mobile-nav-dialog"
  aria-label="Mobile navigation"
  class="fixed inset-0 z-50 m-0 h-full w-full max-h-none max-w-none bg-transparent p-4 backdrop:bg-zinc-800/40 backdrop:backdrop-blur-xs dark:backdrop:bg-black/80"
>
  <div
    data-mobile-menu-panel
    class="mx-auto mt-4 max-w-md rounded-3xl bg-white p-6 shadow-2xl ring-1 ring-zinc-900/5 dark:bg-zinc-900 dark:ring-zinc-800"
  >
    <div class="flex items-center justify-between">
      <h2 class="text-sm font-medium text-zinc-600 dark:text-zinc-400">
        Navigation
      </h2>
      <button
        type="button"
        data-mobile-menu-close
        aria-label="Close navigation menu"
        class="relative -m-2 flex size-12 items-center justify-center rounded-full text-zinc-500 transition hover:bg-zinc-100 hover:text-zinc-800 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-200"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" class="size-6">
          <path
            d="m17.25 6.75-10.5 10.5M6.75 6.75l10.5 10.5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
    <nav aria-label="Mobile" class="mt-4">
      <ul class="divide-y divide-zinc-100 text-base font-medium text-zinc-800 dark:divide-zinc-100/5 dark:text-zinc-200">
        {
          navItems.map((item) => {
            const active = isActive(item.href, pathname);
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'flex min-h-12 items-center justify-between py-3 transition',
                    active
                      ? 'font-semibold text-teal-600 dark:text-teal-400'
                      : 'hover:text-teal-600 dark:hover:text-teal-400',
                  ]}
                >
                  <span>{item.label}</span>
                  {active && (
                    <span class="size-2 rounded-full bg-teal-500 dark:bg-teal-400" aria-hidden="true" />
                  )}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</dialog>

<script src="./header-nav.ts"></script>
