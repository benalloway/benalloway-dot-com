---
import Button from './ui/Button.astro';

const pathname = Astro.url.pathname;

const navItems = [
  { href: '/movies', label: 'Movies' },
  { href: '/articles', label: 'Articles' },
];

function isActive(href: string, currentPath: string) {
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="sticky top-0 z-10 bg-olive-100/95 backdrop-blur-xs dark:bg-olive-950/95">
  <nav aria-label="Primary">
    <div class="mx-auto flex h-[var(--scroll-padding-top)] max-w-7xl items-center gap-4 px-6 lg:px-10">
      <div class="flex flex-1 items-center">
        <a
          href="/"
          aria-label="Ben Alloway — Home"
          class="inline-flex min-h-12 items-center font-display text-xl tracking-tight whitespace-nowrap text-olive-950 transition hover:opacity-70 dark:text-white"
        >
          Ben Alloway
        </a>
      </div>

      <div class="hidden flex-1 justify-center gap-8 lg:flex">
        {
          navItems.map((item) => {
            const active = isActive(item.href, pathname);
            return (
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'inline-flex min-h-11 items-center text-sm/7 font-medium whitespace-nowrap transition',
                  active
                    ? 'text-olive-950 underline decoration-olive-500 decoration-2 underline-offset-8 dark:text-white dark:decoration-olive-300'
                    : 'text-olive-950/70 hover:text-olive-950 dark:text-white/70 dark:hover:text-white',
                ]}
              >
                {item.label}
              </a>
            );
          })
        }
      </div>

      <div class="flex flex-1 items-center justify-end gap-2">
        <Button
          variant="plain"
          size="icon"
          data-theme-toggle
          aria-label="Toggle color theme"
        >
          <svg
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="size-5 fill-olive-950/5 stroke-current transition dark:hidden"
          >
            <path d="M8 12.25A4.25 4.25 0 0 1 12.25 8v0a4.25 4.25 0 0 1 4.25 4.25v0a4.25 4.25 0 0 1-4.25 4.25v0A4.25 4.25 0 0 1 8 12.25v0Z" />
            <path
              d="M12.25 3v1.5M21.5 12.25H20M18.791 18.791l-1.06-1.06M18.791 5.709l-1.06 1.06M12.25 20v1.5M4.5 12.25H3M6.77 6.77 5.709 5.709M6.77 17.73l-1.061 1.061"
              fill="none"
            />
          </svg>
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
            class="hidden size-5 fill-current transition dark:block"
          >
            <path
              d="M17.25 16.22a6.937 6.937 0 0 1-9.47-9.47 7.451 7.451 0 1 0 9.47 9.47ZM12.75 7C17 7 17 2.75 17 2.75S17 7 21.25 7C17 7 17 11.25 17 11.25S17 7 12.75 7Z"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </Button>

        <Button
          variant="plain"
          size="icon"
          data-mobile-menu-open
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="mobile-nav-dialog"
          aria-label="Open navigation menu"
          class="lg:hidden"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-6">
            <path
              fill-rule="evenodd"
              d="M3.748 8.248a.75.75 0 0 1 .75-.75h15a.75.75 0 0 1 0 1.5h-15a.75.75 0 0 1-.75-.75ZM3.748 15.75a.75.75 0 0 1 .75-.751h15a.75.75 0 0 1 0 1.5h-15a.75.75 0 0 1-.75-.75Z"
              clip-rule="evenodd"
            />
          </svg>
        </Button>
      </div>
    </div>

    <!-- Mobile menu: Oatmeal full-screen panel + MD3 48px rows -->
    <dialog
      id="mobile-nav-dialog"
      aria-label="Mobile navigation"
      class="fixed inset-0 z-50 m-0 h-full max-h-none w-full max-w-none bg-transparent p-0 backdrop:bg-transparent"
    >
      <div
        data-mobile-menu-panel
        class="fixed inset-0 bg-olive-100 px-6 py-6 lg:px-10 dark:bg-olive-950"
      >
        <div class="flex justify-end">
          <Button
            variant="plain"
            size="icon-lg"
            data-mobile-menu-close
            aria-label="Close navigation menu"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              aria-hidden="true"
              class="size-6"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
          </Button>
        </div>
        <nav aria-label="Mobile" class="mt-6">
          <div class="flex flex-col gap-2">
            {
              navItems.map((item) => {
                const active = isActive(item.href, pathname);
                return (
                  <a
                    href={item.href}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'group inline-flex min-h-12 items-center justify-between gap-2 text-3xl/10 font-medium transition',
                      active
                        ? 'text-olive-950 dark:text-white'
                        : 'text-olive-950/80 hover:text-olive-950 dark:text-white/80 dark:hover:text-white',
                    ]}
                  >
                    <span>{item.label}</span>
                    <span
                      class="inline-flex p-1.5 opacity-0 transition group-hover:opacity-100"
                      aria-hidden="true"
                    >
                      <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                      </svg>
                    </span>
                  </a>
                );
              })
            }
          </div>
        </nav>
      </div>
    </dialog>
  </nav>
</header>

<script src="./header-nav.ts"></script>
