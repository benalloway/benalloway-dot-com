---
import Container from './ui/Container.astro';
import Divider from './ui/Divider.astro';
import Text from './ui/Text.astro';

const year = new Date().getFullYear();

const links = [
  { href: '/movies', label: 'Movies' },
  { href: '/articles', label: 'Articles' },
];
---

<footer class="mt-24 flex-none sm:mt-32">
  <Container>
    <Divider />
    <div class="flex flex-col items-center justify-between gap-6 pt-10 pb-16 md:flex-row">
      <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm/7 font-medium text-olive-950 dark:text-white">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="inline-flex min-h-11 items-center transition hover:opacity-60"
            >
              {link.label}
            </a>
          ))
        }
      </div>
      <Text size="sm">
        &copy; {year} Ben Alloway. All rights reserved.
      </Text>
    </div>
  </Container>
</footer>
