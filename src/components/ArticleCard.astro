---
import Badge from './Badge.astro';
import { formatDate } from '../lib/formatDate';

interface Props {
  title: string;
  href: string;
  description: string;
  publishedAt: string;
  category?: string;
  cta?: string;
}

const {
  title,
  href,
  description,
  publishedAt,
  category,
  cta = 'Read page',
} = Astro.props;
---

<article class="group relative flex flex-col items-start">
  <h2 class="font-display text-[2rem]/10 tracking-tight text-pretty text-olive-950 sm:text-3xl/10 dark:text-white">
    <a href={href}>
      <span class="absolute inset-0 z-10" aria-hidden="true"></span>
      <span class="relative z-10">{title}</span>
    </a>
  </h2>

  <div class="relative z-10 order-first mb-3 flex flex-wrap items-center gap-3 text-sm/7 text-olive-700 dark:text-olive-400">
    <time datetime={publishedAt}>{formatDate(publishedAt)}</time>
    {category && <Badge color="teal">{category}</Badge>}
  </div>

  <p class="relative z-10 mt-2 text-base/7 text-olive-700 dark:text-olive-400">
    {description}
  </p>

  <div
    aria-hidden="true"
    class="relative z-10 mt-4 inline-flex items-center gap-2 text-sm/7 font-medium text-olive-950 dark:text-white"
  >
    {cta}
    <svg
      viewBox="0 0 16 16"
      fill="none"
      aria-hidden="true"
      class="size-4 stroke-current"
    >
      <path
        d="M6.75 5.75 9.25 8l-2.5 2.25"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </div>
</article>
