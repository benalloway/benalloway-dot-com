---
import Container from './Container.astro';
import Badge from './Badge.astro';
import { formatDate } from '../lib/formatDate';

interface Props {
  title: string;
  description: string;
  publishedAt: string;
  updatedAt?: string;
  category: string;
  tags?: string[];
  backHref?: string;
  backLabel?: string;
}

const {
  title,
  description,
  publishedAt,
  updatedAt,
  category,
  tags = [],
  backHref = '/articles',
  backLabel = 'Back to all pages & articles',
} = Astro.props;
---

<Container class="mt-12 lg:mt-24">
  <div class="xl:relative">
    <div class="mx-auto max-w-2xl">
      <a
        href={backHref}
        aria-label={backLabel}
        class="group relative mb-8 inline-flex size-11 items-center justify-center rounded-full text-olive-950 transition hover:bg-olive-950/10 lg:absolute lg:-left-5 lg:-mt-2 lg:mb-0 xl:-top-1.5 xl:left-0 xl:mt-0 dark:text-white dark:hover:bg-white/10"
      >
        <span
          class="absolute top-1/2 left-1/2 size-[max(100%,3rem)] -translate-x-1/2 -translate-y-1/2 pointer-fine:hidden"
          aria-hidden="true"></span>
        <svg
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
          class="size-4 stroke-current"
        >
          <path
            d="M7.25 11.25 3.75 8m0 0 3.5-3.25M3.75 8h8.5"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>

      <article>
        <header class="flex flex-col">
          <div class="order-first flex flex-wrap items-center gap-3 text-sm/7 text-olive-700 dark:text-olive-400">
            <time datetime={publishedAt}>{formatDate(publishedAt)}</time>
            {
              updatedAt && updatedAt !== publishedAt && (
                <span>· Updated {formatDate(updatedAt)}</span>
              )
            }
            <Badge color="teal">{category}</Badge>
          </div>

          <h1 class="mt-6 font-display text-5xl/12 tracking-tight text-balance text-olive-950 sm:text-6xl/16 dark:text-white">
            {title}
          </h1>

          <div class="mt-6 text-lg/8 text-pretty text-olive-700 dark:text-olive-400">
            {description}
          </div>

          {
            tags.length > 0 && (
              <div class="mt-5 flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <Badge color="zinc">#{tag}</Badge>
                ))}
              </div>
            )
          }
        </header>

        <div class="prose-spotlight mt-10">
          <slot />
        </div>
      </article>
    </div>
  </div>
</Container>
