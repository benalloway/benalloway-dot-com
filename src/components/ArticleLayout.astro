---
import Container from './ui/Container.astro';
import Button from './ui/Button.astro';
import Badge from './ui/Badge.astro';
import Heading from './ui/Heading.astro';
import Text from './ui/Text.astro';
import { formatDate } from '../lib/formatDate';

interface Props {
  title: string;
  description: string;
  publishedAt: string;
  updatedAt?: string;
  category: string;
  tags?: string[];
  backHref?: string;
  backLabel?: string;
}

const {
  title,
  description,
  publishedAt,
  updatedAt,
  category,
  tags = [],
  backHref = '/articles',
  backLabel = 'Back to all pages & articles',
} = Astro.props;
---

<Container class="mt-12 lg:mt-24">
  <div class="xl:relative">
    <div class="mx-auto max-w-2xl">
      <Button
        href={backHref}
        variant="plain"
        size="icon"
        aria-label={backLabel}
        class="mb-8 lg:absolute lg:-left-5 lg:-mt-2 lg:mb-0 xl:-top-1.5 xl:left-0 xl:mt-0"
      >
        <svg
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
          class="size-4 stroke-current"
        >
          <path
            d="M7.25 11.25 3.75 8m0 0 3.5-3.25M3.75 8h8.5"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </Button>

      <article>
        <header class="flex flex-col">
          <div class="order-first flex flex-wrap items-center gap-3 text-sm/7 text-olive-700 dark:text-olive-400">
            <time datetime={publishedAt}>{formatDate(publishedAt)}</time>
            {
              updatedAt && updatedAt !== publishedAt && (
                <span>· Updated {formatDate(updatedAt)}</span>
              )
            }
            <Badge color="teal" size="sm">{category}</Badge>
          </div>

          <Heading level={1} size="xl" class="mt-6">
            {title}
          </Heading>

          <Text as="div" size="lg" class="mt-6 text-pretty">
            {description}
          </Text>

          {
            tags.length > 0 && (
              <div class="mt-5 flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <Badge color="zinc" size="sm">#{tag}</Badge>
                ))}
              </div>
            )
          }
        </header>

        <div class="prose-oatmeal prose-spotlight mt-10">
          <slot />
        </div>
      </article>
    </div>
  </div>
</Container>
