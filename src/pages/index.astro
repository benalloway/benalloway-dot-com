---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Container from '../components/Container.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Badge from '../components/Badge.astro';
import Button from '../components/Button.astro';
import { getAllMovies } from '../data/movies';

const articles = (await getCollection('articles')).sort((a, b) =>
  b.data.publishedAt.localeCompare(a.data.publishedAt),
);

const movies = getAllMovies();
const uhdCount = movies.filter((m) => m.mediaFormat === '4K UHD').length;
const blurayCount = movies.filter((m) => m.mediaFormat === 'Blu-ray').length;
const spotlightMovies = movies.filter((m) => m.isFavorite).slice(0, 5);

const photos = [
  { src: '/images/photos/image-1.jpg', alt: 'Photo placeholder 1', rotate: 'rotate-2' },
  { src: '/images/photos/image-2.jpg', alt: 'Photo placeholder 2', rotate: '-rotate-2' },
  { src: '/images/photos/image-3.jpg', alt: 'Photo placeholder 3', rotate: 'rotate-2' },
  { src: '/images/photos/image-4.jpg', alt: 'Photo placeholder 4', rotate: 'rotate-2' },
  { src: '/images/photos/image-5.jpg', alt: 'Photo placeholder 5', rotate: '-rotate-2' },
];
---

<Base
  title="Home"
  description="Ben Alloway — personal wiki, physical movie collection, favorite films, and notes."
>
  <!-- Hero / About Section (Spotlight layout) -->
  <Container class="mt-10 sm:mt-16">
    <div class="max-w-2xl">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-teal-500/10 px-3 py-1 text-xs font-semibold text-teal-700 dark:bg-teal-400/10 dark:text-teal-300">
        <span>Personal Wiki & Digital Shelf</span>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-zinc-800 sm:text-5xl dark:text-zinc-100">
        Hi, I’m Ben Alloway. Welcome to my corner of the web.
      </h1>
      <p class="mt-6 text-base/7 text-zinc-600 dark:text-zinc-400">
        I’m a software builder based in Virginia. This site is my personal wiki
        and living notebook — a place to catalog the physical movies we own
        (structured for our future Plex server), share ranked lists like my
        all-time favorite films, and publish notes and life updates along the way.
      </p>

      <!-- Primary Mobile-Friendly Quick-Start Menu Actions (MD3 48px+ touch targets) -->
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <Button href="/movies" variant="teal">
          Browse Movies We Own ({movies.length}) →
        </Button>
        <Button href="/articles/favorite-movies" variant="secondary">
          Read: My Top 20 Favorite Movies
        </Button>
        <a
          href="https://github.com/benalloway"
          target="_blank"
          rel="noreferrer"
          aria-label="Ben Alloway on GitHub"
          class="inline-flex min-h-11 items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium text-zinc-600 transition hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" class="size-5 fill-current">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12 2C6.475 2 2 6.588 2 12.253c0 4.537 2.862 8.369 6.838 9.727.5.09.687-.218.687-.487 0-.24-.013-1.05-.013-1.91C7 20.059 6.35 18.957 6.15 18.38c-.113-.295-.6-1.205-1.025-1.448-.35-.192-.85-.667-.013-.68.788-.012 1.35.744 1.538 1.051.9 1.551 2.338 1.116 2.912.846.088-.666.35-1.115.638-1.371-2.225-.256-4.55-1.14-4.55-5.062 0-1.115.387-2.038 1.025-2.756-.1-.256-.45-1.307.1-2.717 0 0 .837-.269 2.75 1.051.8-.23 1.65-.346 2.5-.346.85 0 1.7.115 2.5.346 1.912-1.333 2.75-1.05 2.75-1.05.55 1.409.2 2.46.1 2.716.637.718 1.025 1.628 1.025 2.756 0 3.934-2.337 4.806-4.562 5.062.362.32.675.936.675 1.897 0 1.371-.013 2.473-.013 2.82 0 .268.188.589.688.486a10.039 10.039 0 0 0 4.932-3.74A10.447 10.447 0 0 0 22 12.253C22 6.588 17.525 2 12 2Z"
            ></path>
          </svg>
          <span>GitHub</span>
        </a>
      </div>
    </div>
  </Container>

  <!-- Spotlight Tilted Photo Gallery Strip (Ready for your personal photos) -->
  <div class="mt-14 sm:mt-20">
    <div class="-my-4 flex justify-center gap-4 overflow-hidden py-4 sm:gap-8">
      {
        photos.map((photo) => (
          <div
            class:list={[
              'relative w-40 flex-none overflow-hidden rounded-xl bg-zinc-100 shadow-md ring-1 ring-zinc-900/5 sm:w-64 sm:rounded-2xl dark:bg-zinc-800 dark:ring-white/10',
              photo.rotate,
            ]}
          >
            <div class="aspect-9/10">
              <img
                src={photo.src}
                alt={photo.alt}
                loading="lazy"
                class="absolute inset-0 h-full w-full object-cover"
              />
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Main Two-Column Spotlight Content Area -->
  <Container class="mt-20 md:mt-28">
    <div class="mx-auto grid max-w-xl grid-cols-1 gap-y-16 lg:max-w-none lg:grid-cols-2">
      <!-- Left Column: Featured Wiki Pages & Articles -->
      <div>
        <h2 class="mb-8 text-xs font-semibold tracking-wider text-zinc-400 uppercase dark:text-zinc-500">
          Starting Content · Wiki & Articles
        </h2>
        <div class="flex flex-col gap-14">
          {
            articles.map((article) => (
              <ArticleCard
                title={article.data.title}
                href={`/articles/${article.id}`}
                description={article.data.description}
                publishedAt={article.data.publishedAt}
                category={article.data.category}
                cta="Read article"
              />
            ))
          }
        </div>
      </div>

      <!-- Right Column: Movie Database Shelf Snapshot + Quick Links -->
      <div class="space-y-8 lg:pl-16 xl:pl-24">
        <section class="rounded-2xl border border-zinc-100 p-6 dark:border-zinc-700/40">
          <div class="flex items-center justify-between gap-2">
            <h2 class="flex items-center text-sm font-semibold text-zinc-900 dark:text-zinc-100">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="size-6 flex-none"
              >
                <rect
                  x="2.75"
                  y="4.75"
                  width="18.5"
                  height="14.5"
                  rx="2.5"
                  class="fill-zinc-100 stroke-zinc-400 dark:fill-zinc-100/10 dark:stroke-zinc-500"
                ></rect>
                <path
                  d="M7 5v14M17 5v14M3 9.5h4M17 9.5h4M3 14.5h4M17 14.5h4"
                  class="stroke-zinc-400 dark:stroke-zinc-500"></path>
              </svg>
              <span class="ml-3">Movies We Own</span>
            </h2>
            <Badge color="teal">{movies.length} Titles</Badge>
          </div>

          <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">
            Physical media collection indexed with Plex-compatible metadata
            (<code class="font-mono text-xs">sortTitle</code>,{' '}
            <code class="font-mono text-xs">editionTitle</code>, IMDb/TMDb GUIDs).
          </p>

          <!-- Format Breakdown Pills -->
          <div class="mt-4 grid grid-cols-2 gap-3">
            <div class="rounded-xl bg-zinc-50 px-3.5 py-2.5 dark:bg-zinc-800/60">
              <div class="text-xs text-zinc-500 dark:text-zinc-400">4K UHD Discs</div>
              <div class="mt-0.5 text-lg font-bold text-zinc-900 dark:text-zinc-100">
                {uhdCount}
              </div>
            </div>
            <div class="rounded-xl bg-zinc-50 px-3.5 py-2.5 dark:bg-zinc-800/60">
              <div class="text-xs text-zinc-500 dark:text-zinc-400">Blu-ray Discs</div>
              <div class="mt-0.5 text-lg font-bold text-zinc-900 dark:text-zinc-100">
                {blurayCount}
              </div>
            </div>
          </div>

          <!-- Sample Shelf Highlights -->
          <ol class="mt-6 divide-y divide-zinc-100 dark:divide-zinc-800">
            {
              spotlightMovies.map((movie) => (
                <li class="py-2.5 first:pt-0 last:pb-0">
                  <a
                    href={`/movies/${movie.slug}`}
                    class="group flex min-h-11 items-center justify-between gap-3"
                  >
                    <div class="min-w-0">
                      <p class="truncate text-sm font-medium text-zinc-900 transition group-hover:text-teal-600 dark:text-zinc-100 dark:group-hover:text-teal-400">
                        {movie.title}
                      </p>
                      <p class="text-xs text-zinc-500 dark:text-zinc-400">
                        {movie.year} · {movie.directors[0]}
                        {movie.editionTitle ? ` · ${movie.editionTitle}` : ''}
                      </p>
                    </div>
                    <Badge color={movie.mediaFormat === '4K UHD' ? 'teal' : 'indigo'}>
                      {movie.mediaFormat}
                    </Badge>
                  </a>
                </li>
              ))
            }
          </ol>

          <Button href="/movies" variant="secondary" class="mt-6 w-full">
            Explore Full Movie Database →
          </Button>
        </section>

        <!-- Sister App Card -->
        <section class="rounded-2xl border border-zinc-100 p-6 dark:border-zinc-700/40">
          <h2 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">
            More on benalloway.com
          </h2>
          <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">
            Looking for our family cookbook and capsule meal planner? It runs on
            the same Astro 7 + Cloudflare Workers stack at:
          </p>
          <div class="mt-4">
            <Button href="https://recipes.benalloway.com" variant="secondary" class="w-full">
              recipes.benalloway.com ↗
            </Button>
          </div>
        </section>
      </div>
    </div>
  </Container>
</Base>
