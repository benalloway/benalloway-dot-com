---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Container from '../components/ui/Container.astro';
import AnnouncementBadge from '../components/ui/AnnouncementBadge.astro';
import Heading from '../components/ui/Heading.astro';
import Subheading from '../components/ui/Subheading.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Text from '../components/ui/Text.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import ArticleCard from '../components/ArticleCard.astro';
import MovieShelfCard from '../components/MovieShelfCard.astro';
import { getAllMovies } from '../data/movies';

const articles = (await getCollection('articles')).sort((a, b) =>
  b.data.publishedAt.localeCompare(a.data.publishedAt),
);

const movies = getAllMovies();

const photos = [
  { src: '/images/photos/image-1.jpg', alt: 'Photo placeholder 1', rotate: 'rotate-2' },
  { src: '/images/photos/image-2.jpg', alt: 'Photo placeholder 2', rotate: '-rotate-2' },
  { src: '/images/photos/image-3.jpg', alt: 'Photo placeholder 3', rotate: 'rotate-2' },
  { src: '/images/photos/image-4.jpg', alt: 'Photo placeholder 4', rotate: 'rotate-2' },
  { src: '/images/photos/image-5.jpg', alt: 'Photo placeholder 5', rotate: '-rotate-2' },
];
---

<Base
  title="Home"
  description="Ben Alloway — personal wiki, physical movie collection, favorite films, and notes."
>
  <!-- Hero / About Section (Oatmeal hero-left-aligned) -->
  <Container class="mt-10 sm:mt-16">
    <div class="max-w-2xl">
      <AnnouncementBadge text="Personal Wiki & Digital Shelf" class="mb-4" />

      <Heading level={1} size="display">
        Hi, I’m Ben Alloway. Welcome to my corner of the web.
      </Heading>

      <Text as="div" size="lg" class="mt-6 max-w-2xl text-pretty">
        I’m a software builder based in Virginia. This site is my personal wiki
        and living notebook — a place to catalog the physical movies we own
        (structured for our future Plex server), share ranked lists like my
        all-time favorite films, and publish notes and life updates along the way.
      </Text>

      <!-- Primary Mobile-Friendly Quick-Start Menu Actions (MD3 48px+ touch targets) -->
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <Button href="/movies" variant="primary" size="lg">
          Browse Movies We Own ({movies.length}) →
        </Button>
        <Button href="/articles/favorite-movies" variant="secondary" size="lg">
          Read: My Top 20 Favorite Movies
        </Button>
        <Button
          href="https://github.com/benalloway"
          variant="plain"
          size="md"
          target="_blank"
          rel="noreferrer"
          aria-label="Ben Alloway on GitHub"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" class="size-5 fill-current">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12 2C6.475 2 2 6.588 2 12.253c0 4.537 2.862 8.369 6.838 9.727.5.09.687-.218.687-.487 0-.24-.013-1.05-.013-1.91C7 20.059 6.35 18.957 6.15 18.38c-.113-.295-.6-1.205-1.025-1.448-.35-.192-.85-.667-.013-.68.788-.012 1.35.744 1.538 1.051.9 1.551 2.338 1.116 2.912.846.088-.666.35-1.115.638-1.371-2.225-.256-4.55-1.14-4.55-5.062 0-1.115.387-2.038 1.025-2.756-.1-.256-.45-1.307.1-2.717 0 0 .837-.269 2.75 1.051.8-.23 1.65-.346 2.5-.346.85 0 1.7.115 2.5.346 1.912-1.333 2.75-1.05 2.75-1.05.55 1.409.2 2.46.1 2.716.637.718 1.025 1.628 1.025 2.756 0 3.934-2.337 4.806-4.562 5.062.362.32.675.936.675 1.897 0 1.371-.013 2.473-.013 2.82 0 .268.188.589.688.486a10.039 10.039 0 0 0 4.932-3.74A10.447 10.447 0 0 0 22 12.253C22 6.588 17.525 2 12 2Z"
            />
          </svg>
          <span>GitHub</span>
        </Button>
      </div>
    </div>
  </Container>

  <!-- Tilted Photo Gallery Strip (Ready for personal photos) -->
  <div class="mt-14 sm:mt-20">
    <div class="-my-4 flex justify-center gap-4 overflow-hidden py-4 sm:gap-8">
      {
        photos.map((photo) => (
          <div
            class:list={[
              'relative w-40 flex-none overflow-hidden rounded-xl bg-olive-950/5 shadow-md ring-1 ring-olive-950/10 sm:w-64 sm:rounded-2xl dark:bg-white/5 dark:ring-white/10',
              photo.rotate,
            ]}
          >
            <div class="aspect-9/10">
              <img
                src={photo.src}
                alt={photo.alt}
                loading="lazy"
                class="absolute inset-0 h-full w-full object-cover"
              />
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Main Two-Column Content Area -->
  <Container class="mt-20 md:mt-28">
    <div class="mx-auto grid max-w-xl grid-cols-1 gap-y-16 lg:max-w-none lg:grid-cols-2">
      <!-- Left Column: Featured Wiki Pages & Articles -->
      <div>
        <Eyebrow class="mb-8">Starting Content · Wiki & Articles</Eyebrow>
        <div class="flex flex-col gap-14">
          {
            articles.map((article) => (
              <ArticleCard
                title={article.data.title}
                href={`/articles/${article.id}`}
                description={article.data.description}
                publishedAt={article.data.publishedAt}
                category={article.data.category}
                cta="Read article"
              />
            ))
          }
        </div>
      </div>

      <!-- Right Column: Movie Database Shelf Snapshot + Sister App Card -->
      <div class="space-y-8 lg:pl-16 xl:pl-24">
        <MovieShelfCard movies={movies} />

        <Card as="section" variant="surface" padding="md">
          <Subheading level={2} variant="sans">
            More on benalloway.com
          </Subheading>
          <Text size="sm" class="mt-2">
            Looking for our family cookbook and capsule meal planner? It lives
            right here on this site:
          </Text>
          <div class="mt-4">
            <Button href="/recipes/" variant="secondary" size="lg" class="w-full">
              Open Recipes →
            </Button>
          </div>
        </Card>
      </div>
    </div>
  </Container>
</Base>
