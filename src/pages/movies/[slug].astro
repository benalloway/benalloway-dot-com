---
import Base from '../../layouts/Base.astro';
import Container from '../../components/ui/Container.astro';
import Link from '../../components/ui/Link.astro';
import Card from '../../components/ui/Card.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Heading from '../../components/ui/Heading.astro';
import Text from '../../components/ui/Text.astro';
import Code from '../../components/ui/Code.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import DescriptionList from '../../components/ui/DescriptionList.astro';
import DescriptionTerm from '../../components/ui/DescriptionTerm.astro';
import DescriptionDetails from '../../components/ui/DescriptionDetails.astro';
import Disclosure from '../../components/ui/Disclosure.astro';
import MovieArtwork from '../../components/MovieArtwork.astro';
import {
  getMovieBySlug,
  getExternalId,
  toPlexMetadata,
} from '../../data/movies';

const { slug } = Astro.params;
const movie = slug ? getMovieBySlug(slug) : undefined;

if (!movie) {
  return new Response('Movie not found', { status: 404 });
}

const imdbId = getExternalId(movie, 'imdb');
const tmdbId = getExternalId(movie, 'tmdb');
const plexRecord = toPlexMetadata(movie);
---

<Base
  title={`${movie.title} (${movie.year})`}
  description={`${movie.title} (${movie.year}) — ${movie.mediaFormat} edition in Ben Alloway's movie library.`}
>
  <Container class="mt-12 lg:mt-24">
    <div class="mx-auto max-w-3xl">
      <Link href="/movies" variant="muted" class="mb-8">
        <svg
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
          class="size-4 stroke-current transition-transform group-hover:-translate-x-0.5"
        >
          <path
            d="M7.25 11.25 3.75 8m0 0 3.5-3.25M3.75 8h8.5"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        Back to Movies We Own
      </Link>

      <!-- Hero Showcase Banner -->
      <MovieArtwork movie={movie} variant="hero" />

      {
        movie.notes && (
          <Card variant="tonal" padding="md" class="mt-8">
            <Eyebrow>Shelf & Edition Note</Eyebrow>
            <Text variant="primary" size="sm" class="mt-1.5">
              {movie.notes}
            </Text>
          </Card>
        )
      }

      <!-- Catalyst DescriptionList for Plex & Physical Media Metadata -->
      <section class="mt-10">
        <Heading level={2} size="md">
          Plex & Physical Media Metadata
        </Heading>

        <DescriptionList class="mt-4">
          <DescriptionTerm>
            Sort Title (<Code>sortTitle</Code>)
          </DescriptionTerm>
          <DescriptionDetails class="font-mono text-sm">
            {movie.sortTitle}
          </DescriptionDetails>

          <DescriptionTerm>Director(s)</DescriptionTerm>
          <DescriptionDetails>
            {movie.directors.join(', ')}
          </DescriptionDetails>

          <DescriptionTerm>Writer(s)</DescriptionTerm>
          <DescriptionDetails>
            {movie.writers.join(', ') || '—'}
          </DescriptionDetails>

          <DescriptionTerm>Studio</DescriptionTerm>
          <DescriptionDetails>
            {movie.studio}
          </DescriptionDetails>

          <DescriptionTerm>Video Transfer</DescriptionTerm>
          <DescriptionDetails>
            {movie.videoSpec ?? movie.mediaFormat}
          </DescriptionDetails>

          <DescriptionTerm>Audio Track</DescriptionTerm>
          <DescriptionDetails>
            {movie.audioSpec ?? 'Standard'}
          </DescriptionDetails>

          <DescriptionTerm>Plex Agent GUIDs</DescriptionTerm>
          <DescriptionDetails class="flex flex-wrap gap-2">
            {movie.guids.map((g) => <Badge color="zinc" size="sm">{g.id}</Badge>)}
          </DescriptionDetails>

          <DescriptionTerm>External Links</DescriptionTerm>
          <DescriptionDetails class="flex flex-wrap gap-3">
            {
              imdbId && (
                <Button
                  href={`https://www.imdb.com/title/${imdbId}/`}
                  variant="secondary"
                  size="sm"
                  target="_blank"
                  rel="noreferrer"
                >
                  IMDb ({imdbId}) ↗
                </Button>
              )
            }
            {
              tmdbId && (
                <Button
                  href={`https://www.themoviedb.org/movie/${tmdbId}`}
                  variant="secondary"
                  size="sm"
                  target="_blank"
                  rel="noreferrer"
                >
                  TMDb ({tmdbId}) ↗
                </Button>
              )
            }
          </DescriptionDetails>
        </DescriptionList>
      </section>

      <!-- Principal Cast -->
      {
        movie.cast.length > 0 && (
          <section class="mt-10">
            <Heading level={2} size="md">
              Principal Cast
            </Heading>
            <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
              {movie.cast.map((actor) => (
                <Card
                  variant="surface"
                  padding="sm"
                  class="flex items-center justify-between px-4 py-3"
                >
                  <Text as="span" size="sm" variant="primary" class="font-medium">
                    {actor.name}
                  </Text>
                  <Text as="span" size="xs">
                    as {actor.role}
                  </Text>
                </Card>
              ))}
            </div>
          </section>
        )
      }

      <!-- Portable Plex Metadata JSON Preview -->
      <section class="mt-10">
        <Disclosure title="Portable Plex Metadata JSON Record" meta="Toggle JSON">
          <pre class="overflow-x-auto rounded-xl bg-olive-950 p-4 font-mono text-xs text-olive-100">{JSON.stringify(plexRecord, null, 2)}</pre>
        </Disclosure>
      </section>
    </div>
  </Container>
</Base>
