---
import Base from '../../layouts/Base.astro';
import SimpleLayout from '../../components/SimpleLayout.astro';
import Card from '../../components/ui/Card.astro';
import FilterChip from '../../components/ui/FilterChip.astro';
import TextInput from '../../components/ui/TextInput.astro';
import SelectInput from '../../components/ui/SelectInput.astro';
import Link from '../../components/ui/Link.astro';
import Text from '../../components/ui/Text.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Button from '../../components/ui/Button.astro';
import MovieCard from '../../components/MovieCard.astro';
import { getAllMovies, type MediaFormat } from '../../data/movies';

const movies = getAllMovies();
const formats: Array<'ALL' | MediaFormat> = [
  'ALL',
  '4K UHD',
  'Blu-ray',
  'DVD',
  'Digital',
];

const allGenres = Array.from(
  new Set(movies.flatMap((m) => m.genres)),
).sort();

const genreOptions = [
  { value: 'ALL', label: 'All Genres' },
  ...allGenres.map((genre) => ({ value: genre, label: genre })),
];

const sortOptions = [
  { value: 'sortTitle', label: 'Sort: Plex Sort Title (A–Z)' },
  { value: 'rating-desc', label: 'Sort: Highest Rated' },
  { value: 'year-desc', label: 'Sort: Release Year (Newest)' },
];
---

<Base
  title="Movies We Own"
  description="Physical media shelf and Plex-portable movie collection owned by Ben Alloway."
>
  <SimpleLayout
    eyebrow="Library · Plex Metadata Schema"
    title="Movies we own."
    intro="Our physical media shelf (4K UHD Blu-ray, Criterion editions, and standard Blu-ray), structured with Plex-compatible metadata (sortTitle, editionTitle, IMDb/TMDb GUIDs, and A/V specs) so it stays 1:1 portable with our home Plex server."
  >
    <!-- Ecommerce Category Filter Bar + Catalyst Controls -->
    <Card
      as="section"
      variant="surface"
      padding="md"
      aria-label="Filter and sort movie library"
    >
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div
          role="group"
          aria-label="Filter by media format"
          class="flex flex-wrap gap-2"
        >
          {
            formats.map((fmt) => {
              const count =
                fmt === 'ALL'
                  ? movies.length
                  : movies.filter((m) => m.mediaFormat === fmt).length;
              return (
                <FilterChip
                  label={fmt === 'ALL' ? 'All Formats' : fmt}
                  count={count}
                  pressed={fmt === 'ALL'}
                  data-format-chip={fmt}
                />
              );
            })
          }
        </div>

        <div class="flex items-center gap-3 text-xs/6 font-medium text-olive-700 dark:text-olive-400">
          <Text as="span" size="xs" class="font-medium" data-movie-count>
            {movies.length} films
          </Text>
          <span>·</span>
          <Link
            href="/api/movies.json"
            variant="underline"
            class="inline-flex min-h-10 items-center text-xs/6 font-semibold"
          >
            Plex JSON ↗
          </Link>
        </div>
      </div>

      <!-- Search + Genre + Sort Controls -->
      <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-12">
        <div class="sm:col-span-6">
          <label for="movie-search" class="sr-only">
            Search by title, director, actor, or studio
          </label>
          <TextInput
            id="movie-search"
            type="search"
            icon="search"
            data-movie-search
            placeholder="Search title, director, cast, or edition…"
          />
        </div>

        <div class="sm:col-span-3">
          <label for="movie-genre" class="sr-only">Filter by genre</label>
          <SelectInput
            id="movie-genre"
            options={genreOptions}
            data-movie-genre
          />
        </div>

        <div class="sm:col-span-3">
          <label for="movie-sort" class="sr-only">Sort movies</label>
          <SelectInput
            id="movie-sort"
            options={sortOptions}
            data-movie-sort
          />
        </div>
      </div>
    </Card>

    <!-- Ecommerce Product Cards Grid -->
    <div
      data-movie-grid
      class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
    >
      {movies.map((movie) => <MovieCard movie={movie} />)}
    </div>

    <!-- Empty Filter State -->
    <EmptyState
      dashed
      hidden
      data-movie-empty
      title="No movies match those filters."
      description="Try clearing your search query or switching the format filter back to All."
      class="mt-8"
    >
      <Button variant="primary" data-movie-reset>
        Reset filters
      </Button>
    </EmptyState>
  </SimpleLayout>
</Base>

<script src="../../components/movie-filter.ts"></script>
