// MVP serves wiki content + Plex-portable movie catalog without D1/R2 bindings yet.
// When D1/R2 milestones land, add `d1_databases` (`DB`) and `r2_buckets` (`MEDIA`) here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "benalloway-dot-com",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "SESSION", "id": "c5ef636441994c10ba7dd87ad8d224eb" }
  ],
  "routes": [
    { "pattern": "benalloway.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
